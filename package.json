    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "24.19.0",
    "axe-core": "4.14.1",
    "playwright-core": "1.65.1",
    "typescript": "7.0.2"
  }
